    "00ff10ab",
    "",
  ];
  for (let i: i32 = 0; i < 2 && i < table_b.length; i += 1) {
    const r_b: string = table_b[i];
    const v_b: u8[] = unhex(r_b);
    const v_e: string = hexEncode(v_b);
    const holds: boolean = strEq(v_e, shiftCase(v_e, false));
    if (!holds) {
      return t.fail("[P-ENC-LOWER] the encoding has no uppercase digit (R-ENC-ONLY)", `sample ${i + 1} of 2 (len(b) = ${toI32(v_b.length)}): the assertion is false`);
    }
  }
  return t.pass("[P-ENC-LOWER] the encoding has no uppercase digit (R-ENC-ONLY) — 2 samples");
};

/**
