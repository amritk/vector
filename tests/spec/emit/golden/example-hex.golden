      return t.fail("[P-ROUND-TRIP] hexDecode(hexEncode(b)) is b (R-ROUND-TRIP, R-ENC-ONLY)", `sample ${i + 1} of 2 (len(b) = ${toI32(v_b.length)}): ${why}`);
    }
  }
  return t.pass("[P-ROUND-TRIP] hexDecode(hexEncode(b)) is b (R-ROUND-TRIP, R-ENC-ONLY) — 2 samples");
};

