 *
 * R-ENC-ONLY — example-hex §3.2, MUST NOT:
 *   hexEncode MUST NOT emit uppercase digits, separators or a prefix.
 */
const clause_P_ROUND_TRIP = (t: Suite): boolean => {
  const table_b: string[] = [
    "00ff10ab",
    "",
  ];
  for (let i: i32 = 0; i < 2 && i < table_b.length; i += 1) {
    const r_b: string = table_b[i];
    const v_b: u8[] = unhex(r_b);
    const u: Unwrap = new Unwrap();
    const v_d: u8[] | null = hexDecode(hexEncode(v_b));
    const holds: boolean = (!isNullBytes(v_d) && bytesEq(u.get(v_d), v_b));
    if (u.sawNull || !holds) {
      let why: string = "the assertion is false";
      if (u.sawNull) {
        why = "unwrap met a null";
