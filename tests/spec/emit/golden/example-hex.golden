import { Suite } from "nish/testing";
import { hexDecode, hexEncode } from "nish/hex";

/** `bytes` as lowercase hex, the way the RFC prints them. */
const hexOf = (bytes: u8[]): string => {
  const digits: string = "0123456789abcdef";
  const parts: string[] = [];
  for (const b of bytes) {
    const v: i32 = toI32(b);
    parts.push(digits.substring(v >> 4, (v >> 4) + 1));
    parts.push(digits.substring(v & 15, (v & 15) + 1));
  }
  return parts.join("");
};

/** `bytes` as hex, or `null` spelled out. */
const hexOrNull = (bytes: u8[] | null): string => {
  if (bytes !== null) {
    return hexOf(bytes);
  }
  return "null";
};

/** The bytes a lowercase hex string spells. */
const unhex = (hex: string): u8[] => {
  const n: i32 = toI32(hex.length) >> 1;
  const out: u8[] = new Array<u8>(n);
  for (let i: i32 = 0; i < n; i += 1) {
    out[i] = toU8(nibble(hex.charCodeAt(2 * i)) * 16 + nibble(hex.charCodeAt(2 * i + 1)));
  }
  return out;
};

/** One hex digit's value. */
const nibble = (c: number): i32 => {
  const v: i32 = toI32(c);
  if (v >= 97) {
    return v - 87;
  }
  return v - 48;
};

/**
 * RFC 4648 §10: BASE16("") = "" decodes to the empty array
 *
 * R-DEC-EMPTY — example-hex §4.3, MUST:
 *   hexDecode of the empty string MUST return an empty array, not null.
 */
const clause_V1 = (t: Suite): boolean => t.eqStr("[V1] RFC 4648 §10: BASE16(\"\") = \"\" decodes to the empty array (R-DEC-EMPTY)", hexOrNull(hexDecode("")), "");

/**
 * RFC 4648 §10: BASE16("f") = "66" decodes back
 *
 * R-DEC-ACCEPT — example-hex §4.1, MUST:
 *   hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case.
 *
 * R-ROUND-TRIP — example-hex §4.4, MUST:
 *   For all bytes b, hexDecode(hexEncode(b)) MUST equal b.
 */
const clause_V2 = (t: Suite): boolean => t.eqStr("[V2] RFC 4648 §10: BASE16(\"f\") = \"66\" decodes back (R-DEC-ACCEPT, R-ROUND-TRIP)", hexOrNull(hexDecode("66")), "66");

/**
 * RFC 4648 §10: uppercase "666F6F" decodes to "foo"
 *
 * R-DEC-ACCEPT — example-hex §4.1, MUST:
 *   hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case.
 */
const clause_V3 = (t: Suite): boolean => t.eqStr("[V3] RFC 4648 §10: uppercase \"666F6F\" decodes to \"foo\" (R-DEC-ACCEPT)", hexOrNull(hexDecode("666F6F")), "666f6f");

/**
 * RFC 4648 §10: uppercase "666F6F626172" decodes to "foobar"
 *
 * R-DEC-ACCEPT — example-hex §4.1, MUST:
 *   hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case.
 */
const clause_V4 = (t: Suite): boolean => t.eqStr("[V4] RFC 4648 §10: uppercase \"666F6F626172\" decodes to \"foobar\" (R-DEC-ACCEPT)", hexOrNull(hexDecode("666F6F626172")), "666f6f626172");

/**
 * every nibble boundary, encoded high nibble first in lowercase
 *
 * R-ENC-LEN — example-hex §3.1, MUST:
 *   hexEncode MUST return exactly two characters per input byte.
 *
 * R-ENC-DIGITS — example-hex §3.2, MUST:
 *   Each byte MUST be written high nibble first, using the digits 0-9 and
 *   a-f.
 *
 * R-ENC-ONLY — example-hex §3.2, MUST NOT:
 *   hexEncode MUST NOT emit uppercase digits, separators or a prefix.
 */
const clause_V5 = (t: Suite): boolean => t.eqStr("[V5] every nibble boundary, encoded high nibble first in lowercase (R-ENC-LEN, R-ENC-DIGITS, R-ENC-ONLY)", hexEncode(unhex("000ff0ff")), "000ff0ff");

/**
