export const main = (): i32 => {
  const t: Suite = new Suite("example-hex");
  let ran: string = "";
  ran = `${ran}${clause_V1(t) ? "1" : "0"}`;
  ran = `${ran}${clause_V2(t) ? "1" : "0"}`;
