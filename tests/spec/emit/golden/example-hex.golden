  ran = `${ran}${clause_P_ENC_LEN(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_ENC_LOWER(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_ROUND_TRIP(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_CANONICAL(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_ANY_CASE(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_ODD(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_OTHER(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_OTHER_EDGE(t) ? "1" : "0"}`;
  ran = `${ran}${clause_P_PREFIX(t) ? "1" : "0"}`;
  const code: i32 = t.done();
  const argv: string[] = process.argv;
  const nonce: string = 1 < argv.length ? argv[1] : "-";
  console.log(`vector-done ${nonce} ${ran}`);
  return code;
};
