import { Suite } from "nish/testing";
import { hexDecode, hexEncode } from "nish/hex";
import { wrappingMul } from "nish:unsafe";

/** `bytes` as lowercase hex, the way the RFC prints them. */
const hexOf = (bytes: u8[]): string => {
  const digits: string = "0123456789abcdef";
  const parts: string[] = [];
  for (const b of bytes) {
    const v: i32 = toI32(b);
    parts.push(digits.substring(v >> 4, (v >> 4) + 1));
    parts.push(digits.substring(v & 15, (v & 15) + 1));
  }
  return parts.join("");
};

/** `bytes` as hex, or `null` spelled out. */
const hexOrNull = (bytes: u8[] | null): string => {
  if (bytes !== null) {
    return hexOf(bytes);
  }
  return "null";
};

/** The bytes a lowercase hex string spells. */
const unhex = (hex: string): u8[] => {
  const out: u8[] = [];
  const n: i32 = toI32(hex.length);
  for (let i: i32 = 0; i < n - 1; i += 2) {
    if (i + 1 < hex.length) {
      out.push(toU8((nibble(hex.charCodeAt(i)) << 4) | nibble(hex.charCodeAt(i + 1))));
    }
  }
  return out;
};

/** One lowercase hex digit's value (0 for any other character). */
const nibble = (c: number): i32 => {
  const v: i32 = toI32(c);
  if (v >= 97 && v <= 102) {
    return v - 87;
  }
  if (v >= 48 && v <= 57) {
    return v - 48;
  }
  return 0;
};

/** Equal contents, or both null. */
const bytesEq = (a: u8[] | null, b: u8[] | null): boolean => {
  if (a === null || b === null) {
    return a === null && b === null;
  }
  const x: u8[] = a;
  const y: u8[] = b;
  if (x.length !== y.length) {
    return false;
  }
  for (let i: i32 = 0; i < toI32(x.length); i += 1) {
    if (i < y.length && x[i] !== y[i]) {
      return false;
    }
  }
  return true;
};

const isNullBytes = (b: u8[] | null): boolean => b === null;

/** Equal characters, or both null. */
const strEq = (a: string | null, b: string | null): boolean => {
  if (a === null || b === null) {
    return a === null && b === null;
  }
  const x: string = a;
  const y: string = b;
  if (x.length !== y.length) {
    return false;
  }
  for (let i: i32 = 0; i < toI32(x.length); i += 1) {
    if (i < y.length && x.charCodeAt(i) !== y.charCodeAt(i)) {
      return false;
    }
  }
  return true;
};

/** `s` with every ASCII letter in upper case, or in lower case when not `upper`. */
const shiftCase = (s: string, upper: boolean): string => {
  const parts: string[] = [];
  const n: i32 = toI32(s.length);
  for (let i: i32 = 0; i < n; i += 1) {
    let c: i32 = toI32(s.charCodeAt(i));
    if (upper && c >= 97 && c <= 122) {
      c = c - 32;
    }
    if (!upper && c >= 65 && c <= 90) {
      c = c + 32;
    }
    parts.push(String.fromCharCode(c));
  }
  return parts.join("");
};

/**
 * `unwrap` without exceptions: a null is recorded and stands in as no bytes,
 * and the sample that saw it fails.
 */
class Unwrap {
  sawNull: boolean

  constructor() {
    this.sawNull = false
  }

  get(b: u8[] | null): u8[] {
    if (b !== null) {
      return b
    }
    this.sawNull = true
    return []
  }
}

/**
 * RFC 4648 §10: BASE16("") = "" decodes to the empty array
 *
 * R-DEC-EMPTY — example-hex §4.3, MUST:
 *   hexDecode of the empty string MUST return an empty array, not null.
 */
const clause_V1 = (t: Suite): boolean => t.eqStr("[V1] RFC 4648 §10: BASE16(\"\") = \"\" decodes to the empty array (R-DEC-EMPTY)", hexOrNull(hexDecode("")), "");

/**
 * RFC 4648 §10: BASE16("f") = "66" decodes back
 *
 * R-DEC-ACCEPT — example-hex §4.1, MUST:
 *   hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case.
 *
 * R-ROUND-TRIP — example-hex §4.4, MUST:
 *   For all bytes b, hexDecode(hexEncode(b)) MUST equal b.
 */
const clause_V2 = (t: Suite): boolean => t.eqStr("[V2] RFC 4648 §10: BASE16(\"f\") = \"66\" decodes back (R-DEC-ACCEPT, R-ROUND-TRIP)", hexOrNull(hexDecode("66")), "66");

/**
