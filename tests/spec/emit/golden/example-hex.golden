/**
 * two characters per byte
 *
 * R-ENC-LEN — example-hex §3.1, MUST:
 *   hexEncode MUST return exactly two characters per input byte.
 */
const clause_P_ENC_LEN = (t: Suite): boolean => {
  const table_b: string[] = [
    "00ff10ab",
    "",
  ];
  for (let i: i32 = 0; i < 2 && i < table_b.length; i += 1) {
    const r_b: string = table_b[i];
    const v_b: u8[] = unhex(r_b);
    const holds: boolean = (toI32(hexEncode(v_b).length) === wrappingMul(2, toI32(v_b.length)));
    if (!holds) {
      return t.fail("[P-ENC-LEN] two characters per byte (R-ENC-LEN)", `sample ${i + 1} of 2 (len(b) = ${toI32(v_b.length)}): the assertion is false`);
    }
  }
  return t.pass("[P-ENC-LEN] two characters per byte (R-ENC-LEN) — 2 samples");
};

/**
 * the encoding has no uppercase digit
 *
 * R-ENC-ONLY — example-hex §3.2, MUST NOT:
 *   hexEncode MUST NOT emit uppercase digits, separators or a prefix.
