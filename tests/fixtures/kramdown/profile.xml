    <section anchor="encoding">
      <name>Encoding</name>
      <section anchor="length">
        <name>Length</name>
        <t anchor="R-ENC-LEN">hexEncode <bcp14>MUST</bcp14> return exactly two characters per input byte.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ENC-LEN covers R-ENC-LEN, R-ENC-DIGITS — two characters per byte
// samples: 48
forall (b: u8[] /* 0..64 */) => hexEncode(b).length === 2 * b.length
]]></sourcecode>
      </section>
      <section anchor="digits">
        <name>Digits</name>
        <t anchor="R-ENC-DIGITS">Each byte <bcp14>MUST</bcp14> be written high nibble first, using the digits 0-9 and a-f.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ENC-LOWER covers R-ENC-DIGITS — output is lowercase
forall (b: u8[] /* 0..64 */, t: string /* 0..32 hexdigit HEXDIGIT */) => { const e = hexEncode(b); return e === e.toLowerCase(); }
where t.length % 2 === 0
]]></sourcecode>
      </section>
    </section>
