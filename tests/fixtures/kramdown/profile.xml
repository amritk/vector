      <section anchor="rejected-input">
        <name>Rejected input</name>
        <t anchor="R-DEC-REJECT">hexDecode <bcp14>MUST</bcp14> return null when the text has an odd length or contains any
other character, including whitespace and a "0x" prefix.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-DEC-ODD covers R-DEC-REJECT — odd-length text is rejected
forall (t: string /* 1..1 " \t\n\r!" */, n: i32 /* 0..31 */) => implies(n % 2 === 1, hexDecode(t.repeat(n)) === null)
]]></sourcecode>
      </section>
