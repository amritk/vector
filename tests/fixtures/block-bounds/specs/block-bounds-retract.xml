    <section anchor="validity">
      <name>Validity</name>
      <t>A text is valid when it is an even run of hex digits.</t>
      <t anchor="R-VALID">miniIsValid <bcp14>MUST</bcp14> return false for any text other than an even run of hex digits.</t>
      <sourcecode type="ts-property"><![CDATA[
// P-ODD covers R-VALID — a text of odd length is not
forall (t: string /* 1..33 hexdigit */) => miniIsValid(t) === false
where t.length % 2 === 1
]]></sourcecode>
