    <section anchor="length">
      <name>Length</name>
      <t>No bytes encode as the empty text, "".</t>
      <t anchor="R-ENC-LEN">miniEncode <bcp14>MUST</bcp14> return exactly two characters per input byte.</t>
      <sourcecode type="ts-property"><![CDATA[
// P-ENC-LEN covers R-ENC-LEN, R-ENC-LOWER — two characters per byte
forall (b: u8[] /* 0..64 */) => miniEncode(b).length === 2 * b.length
]]></sourcecode>
      <t anchor="R-ENC-LOWER">miniEncode <bcp14>MUST NOT</bcp14> emit uppercase digits.</t>
