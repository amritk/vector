{
  "$schema": "../../../../schemas/rfc-contract.json",
  "contract": "byte-order",
  "source": {
    "title": "Integers as Bytes: Properties",
    "main": "byte-order",
    "sha256": "48f72e250f8b5d9227a994ae66e7662294240ac46224d262c46783f83db5f9a0"
  },
  "sources": [
    {
      "id": "byte-order",
      "path": "../rfcs/byte-order.txt",
      "sha256": "48f72e250f8b5d9227a994ae66e7662294240ac46224d262c46783f83db5f9a0"
    }
  ],
  "target": {
    "module": "vector/core/hex"
  },
  "requirements": [
    {
      "id": "R-WRITE",
      "section": "1",
      "level": "MUST",
      "quote": "An integer written as bytes MUST be written as its two's complement, in the byte order the operation names."
    },
    {
      "id": "R-READ",
      "section": "2",
      "level": "MUST",
      "quote": "Bytes read as an integer MUST be read in the byte order the operation names, as exactly as many bytes as the integer's width."
    }
  ],
  "exclusions": [],
  "functions": [
    {
      "name": "toHex",
      "params": [
        {
          "name": "bytes",
          "type": "bytes"
        }
      ],
      "returns": "string"
    }
  ],
  "clauses": [
    {
      "kind": "property",
      "id": "P-BE32",
      "title": "a u32 written big-endian is 4 bytes, and reads back",
      "covers": [
        "R-WRITE",
        "R-READ"
      ],
      "forall": [
        {
          "name": "n",
          "type": "u32",
          "min": 0,
          "max": 4294967295
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "==",
            "args": [
              {
                "op": "strLen",
                "args": [
                  {
                    "call": "toHex",
                    "args": [
                      {
                        "op": "be32",
                        "args": [
                          {
                            "var": "n"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "int": 8
              }
            ]
          },
          {
            "op": "==",
            "args": [
              {
                "op": "beU32",
                "args": [
                  {
                    "op": "be32",
                    "args": [
                      {
                        "var": "n"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "n"
              }
            ]
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-LE-I32",
      "title": "a negative i32 is written in two's complement",
      "covers": [
        "R-WRITE"
      ],
      "forall": [
        {
          "name": "n",
          "type": "i32",
          "min": -2147483648,
          "max": -1
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "==",
            "args": [
              {
                "call": "toHex",
                "args": [
                  {
                    "op": "le32",
                    "args": [
                      {
                        "var": "n"
                      }
                    ]
                  }
                ]
              },
              {
                "call": "toHex",
                "args": [
                  {
                    "op": "slice",
                    "args": [
                      {
                        "op": "le64",
                        "args": [
                          {
                            "var": "n"
                          }
                        ]
                      },
                      {
                        "int": 0
                      },
                      {
                        "int": 4
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "==",
            "args": [
              {
                "op": "leI32",
                "args": [
                  {
                    "op": "le32",
                    "args": [
                      {
                        "var": "n"
                      }
                    ]
                  }
                ]
              },
              {
                "var": "n"
              }
            ]
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-READ-64",
      "title": "eight bytes read either way write back as they were",
      "covers": [
        "R-READ"
      ],
      "forall": [
        {
          "name": "b",
          "type": "bytes",
          "minLen": 8,
          "maxLen": 8
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "==",
            "args": [
              {
                "call": "toHex",
                "args": [
                  {
                    "op": "le64",
                    "args": [
                      {
                        "op": "leU64",
                        "args": [
                          {
                            "var": "b"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "call": "toHex",
                "args": [
                  {
                    "var": "b"
                  }
                ]
              }
            ]
          },
          {
            "op": "==",
            "args": [
              {
                "call": "toHex",
                "args": [
                  {
                    "op": "be64",
                    "args": [
                      {
                        "op": "beI64",
                        "args": [
                          {
                            "var": "b"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "call": "toHex",
                "args": [
                  {
                    "var": "b"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "kind": "property",
      "id": "P-READ-LEN",
      "title": "a 32-bit read of any length holds",
      "covers": [
        "R-READ"
      ],
      "forall": [
        {
          "name": "b",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 8
        }
      ],
      "assert": {
        "op": "and",
        "args": [
          {
            "op": "==",
            "args": [
              {
                "op": "leU32",
                "args": [
                  {
                    "var": "b"
                  }
                ]
              },
              {
                "op": "leU32",
                "args": [
                  {
                    "var": "b"
                  }
                ]
              }
            ]
          },
          {
            "op": "==",
            "args": [
              {
                "op": "strLen",
                "args": [
                  {
                    "call": "toHex",
                    "args": [
                      {
                        "var": "b"
                      }
                    ]
                  }
                ]
              },
              {
                "op": "*",
                "args": [
                  {
                    "int": 2
                  },
                  {
                    "op": "len",
                    "args": [
                      {
                        "var": "b"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
