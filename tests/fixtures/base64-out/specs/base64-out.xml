  <front>
    <title abbrev="base64 out">Base 64 written into a caller's buffer</title>
    <seriesInfo name="Internet-Draft" value="draft-base64-out-00"/>
    <author initials="V." surname="Fixture" fullname="Vector Fixture">
      <organization>vector</organization>
