{
  "$schema": "../../../../schemas/rfc-contract.json",
  "contract": "rfc9000-txt",
  "source": {
    "rfc": 9000,
    "title": "QUIC: A UDP-Based Multiplexed and Secure Transport",
    "sha256": "d6583fba96f053b59af45e310120f5e479613ef40212854e85bd082974f20b23"
  },
  "sources": [
    {
      "id": "rfc9000",
      "rfc": 9000,
      "file": "rfcs/rfc9000.txt",
      "sha256": "d6583fba96f053b59af45e310120f5e479613ef40212854e85bd082974f20b23"
    }
  ],
  "target": {
    "module": "nish/quic/varint"
  },
  "requirements": [
    {
      "id": "R-MINIMUM",
      "section": "16",
      "level": "DEFINITION",
      "quote": "Values do not need to be encoded on the minimum number of bytes necessary, with the sole exception of the Frame Type field"
    }
  ],
  "functions": [
    {
      "name": "varintEncode",
      "params": [
        {
          "name": "v",
          "type": "u64"
        }
      ],
      "returns": "bytes"
    }
  ],
  "clauses": [
    {
      "kind": "property",
      "id": "P-AT-MOST-EIGHT",
      "title": "an encoded integer is at most eight bytes",
      "covers": [
        "R-MINIMUM"
      ],
      "forall": [
        {
          "name": "v",
          "type": "u64",
          "min": 0,
          "max": "4611686018427387903"
        }
      ],
      "assert": {
        "op": "<=",
        "args": [
          {
            "op": "len",
            "args": [
              {
                "call": "varintEncode",
                "args": [
                  {
                    "var": "v"
                  }
                ]
              }
            ]
          },
          {
            "int": 8
          }
        ]
      }
    }
  ]
}
