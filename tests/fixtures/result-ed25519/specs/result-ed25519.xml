  <middle>
    <section anchor="interface">
      <name>Interface</name>
      <sourcecode type="ts-interface"><![CDATA[
// module: nish/crypto/ed25519
export const ed25519PublicKey = (seed: u8[]): u8[] | null
export const ed25519Sign = (seed: u8[], msg: u8[]): u8[] | null
export const ed25519Verify = (pub: u8[], msg: u8[], sig: u8[]): boolean
]]></sourcecode>
    </section>
    <section anchor="ed25519">
      <name>Ed25519</name>
      <blockquote anchor="R-PUB">
        <t>The 32-byte public key is generated by the following steps. <xref section="5.1.5" sectionFormat="of" target="RFC8032"/></t>
      </blockquote>
      <blockquote anchor="R-SIGN">
        <t>The inputs to the signing procedure is the private key, a 32-octet string, and a message M of arbitrary size. <xref section="5.1.6" sectionFormat="of" target="RFC8032"/></t>
      </blockquote>
      <blockquote anchor="R-VERIFY-EQ">
        <t>Check the group equation [8][S]B = [8]R + [8][k]A'. <xref section="5.1.7" sectionFormat="of" target="RFC8032"/></t>
      </blockquote>
      <sourcecode type="ts-property"><![CDATA[
// P-ROUNDTRIP covers R-VERIFY-EQ — a signature verifies under the seed's public key
forall (seed: u8[] /* 32..32 */, msg: u8[] /* 0..130 */) =>
  ed25519Verify(unwrap(ed25519PublicKey(seed)), msg, unwrap(ed25519Sign(seed, msg))) === true
]]></sourcecode>
