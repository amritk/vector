  "requirements": [
    {
      "id": "R-PUB",
      "section": "5.1.5",
      "level": "DEFINITION",
      "quote": "The 32-byte public key is generated by the following steps."
    },
    {
      "id": "R-SIGN",
      "section": "5.1.6",
      "level": "DEFINITION",
      "quote": "The inputs to the signing procedure is the private key, a 32-octet string, and a message M of arbitrary size."
    },
    {
      "id": "R-VERIFY-EQ",
      "section": "5.1.7",
      "level": "DEFINITION",
      "quote": "Check the group equation [8][S]B = [8]R + [8][k]A'."
    }
  ],
  "exclusions": [
    {
      "section": "5.1",
      "quote": "The context (if present at all) MUST be empty.",
      "reason": "no function takes a context, so there is none to be empty."
    },
    {
      "section": "8.7",
      "quote": "In particular, unless the underlying protocol does not require it, the receiver MUST buffer the entire message (or enough information to reconstruct it, e.g., compressed or encrypted version) to be verified.",
      "reason": "a receiver's buffering is not the module's."
    }
  ],
  "functions": [
    {
      "name": "ed25519PublicKey",
      "params": [
        {
          "name": "seed",
          "type": "bytes"
        }
      ],
      "returns": "bytes?"
    },
    {
      "name": "ed25519Sign",
      "params": [
        {
          "name": "seed",
          "type": "bytes"
        },
        {
          "name": "msg",
          "type": "bytes"
        }
