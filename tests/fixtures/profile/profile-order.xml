      <section anchor="rejected-input">
        <name>Rejected input</name>
        <t anchor="R-DEC-REJECT">hexDecode <bcp14>MUST</bcp14> return null when the text has an odd length or contains any
other character, including whitespace and a "0x" prefix.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-DEC-ODD covers R-DEC-REJECT — odd-length text is rejected
forall (t: string /* 1..33 hexdigit */) => implies(t.length % 2 === 1, hexDecode(t) === null)
]]></sourcecode>
        <sourcecode type="ts-property"><![CDATA[
// P-DEC-OTHER covers R-DEC-REJECT — any other character is refused
forall (
  a: string /* 0..16 hexdigit HEXDIGIT */,
  x: string /* 1..1 "gG \"x" */,
  z: string /* 0..16 hexdigit HEXDIGIT */,
) => hexDecode(a + (x + z)) === null
where (a + (x + z)).length % 2 === 0
]]></sourcecode>
      </section>
      <section anchor="empty-input">
        <name>Empty input</name>
        <t anchor="R-DEC-EMPTY">hexDecode of the empty string <bcp14>MUST</bcp14> return an empty array, not null.</t>
      </section>
      <section anchor="round-trip">
        <name>Round trip</name>
        <t anchor="R-ROUND-TRIP">For all bytes b, hexDecode(hexEncode(b)) <bcp14>MUST</bcp14> equal b.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ROUND-TRIP covers R-ROUND-TRIP — hexDecode(hexEncode(b)) is b
forall (b: u8[] /* 0..64 */) => {
  const d = hexDecode(hexEncode(b));
  return d !== null && unwrap(d) === b;
}
]]></sourcecode>
      </section>
