{
  "contract": {
    "contract": "profile-hex",
    "source": {
      "title": "Profile fixture: a spec the profile reads into a contract",
      "main": "profile-hex"
    },
    "sources": [
      {
        "id": "profile-hex",
        "path": "../specs/profile-hex.xml"
      },
      {
        "id": "rfc4648",
        "rfc": 4648
      }
    ],
    "target": {
      "module": "nish/hex"
    },
    "requirements": [
      {
        "id": "R-ENC-LEN",
        "section": "3.1",
        "level": "MUST",
        "quote": "hexEncode MUST return exactly two characters per input byte."
      },
      {
        "id": "R-ENC-DIGITS",
        "section": "3.2",
        "level": "MUST",
        "quote": "Each byte MUST be written high nibble first, using the digits 0-9 and a-f."
      },
      {
        "id": "R-DEF-DIGIT",
        "section": "4.1",
        "level": "DEFINITION",
        "quote": "a hex digit is one of the characters 0-9, a-f and A-F."
      },
      {
        "id": "R-RFC-VECTORS",
        "source": "rfc4648",
        "section": "10",
        "level": "DEFINITION",
        "quote": "BASE16(\"f\") = \"66\""
      },
      {
        "id": "R-DEC-REJECT",
        "section": "4.2",
        "level": "MUST",
        "quote": "hexDecode MUST return null when the text has an odd length or contains any other character, including whitespace and a \"0x\" prefix."
      },
      {
        "id": "R-DEC-EMPTY",
        "section": "4.3",
        "level": "MUST",
        "quote": "hexDecode of the empty string MUST return an empty array, not null."
      },
      {
        "id": "R-ROUND-TRIP",
        "section": "4.4",
        "level": "MUST",
        "quote": "For all bytes b, hexDecode(hexEncode(b)) MUST equal b."
      }
    ],
    "exclusions": [
      {
        "source": "rfc4648",
        "section": "10",
        "quote": "BASE16(\"fo\") = \"666F\"",
        "reason": "the reference prints uppercase digits. Checked by: R-ENC-DIGITS."
      },
      {
        "section": "4.5",
        "quote": "hexDecode MUST NOT index a table by the value of a digit.",
        "reason": "timing is not observable from a unit test. Checked by: code review."
      },
      {
        "section": "4.5",
        "quote": "Callers SHOULD NOT decode secrets with this module.",
        "reason": "an obligation on the caller."
      }
    ],
    "functions": [
      {
        "name": "hexEncode",
        "params": [
          {
            "name": "bytes",
            "type": "bytes"
          }
        ],
        "returns": "string"
      },
      {
        "name": "hexDecode",
        "params": [
          {
            "name": "text",
            "type": "string"
          }
        ],
        "returns": "bytes?"
      }
    ],
    "clauses": [
      {
        "kind": "vector",
        "id": "V1",
        "title": "empty input decodes to empty bytes",
        "covers": ["R-DEC-EMPTY"],
        "source": {
          "cite": {
            "source": "rfc4648",
            "section": "10"
          }
        },
        "call": "hexDecode",
        "args": [
          {
            "str": ""
          }
        ],
        "expect": {
          "ascii": ""
        }
      },
      {
        "kind": "vector",
        "id": "V2",
        "title": "one byte",
        "covers": ["R-RFC-VECTORS"],
        "source": {
          "cite": {
            "source": "rfc4648",
            "section": "10"
          }
        },
        "call": "hexDecode",
        "args": [
          {
            "str": "66"
          }
        ],
        "expect": {
          "ascii": "f"
        }
      },
      {
        "kind": "vector",
        "id": "V3",
        "title": "bytes literal",
        "covers": ["R-ENC-LEN"],
        "source": {
          "command": "python3 -c 'print(bytes([0,15,240,255]).hex())'"
        },
        "section": "5",
        "call": "hexEncode",
        "args": [
          {
            "hex": "000ff0ff"
          }
        ],
        "expect": {
          "str": "000ff0ff"
        }
      },
      {
        "kind": "vector",
        "id": "V4",
        "title": "odd length",
        "covers": ["R-DEC-REJECT"],
        "source": {
          "spec": "4.3"
        },
        "section": "5",
        "call": "hexDecode",
        "args": [
          {
            "str": "abc"
          }
        ],
        "expect": {
          "null": true
        }
      },
      {
        "kind": "vector",
        "id": "V5",
        "title": "empty bytes literal",
        "covers": ["R-DEC-EMPTY"],
        "source": {
          "cite": {
            "section": "4.3"
          }
        },
        "call": "hexEncode",
        "args": [
          {
            "hex": ""
          }
        ],
        "expect": {
          "str": ""
        }
      },
      {
        "kind": "vector",
        "id": "V6",
        "title": "string with escapes",
        "covers": ["R-DEC-REJECT", "R-DEF-DIGIT"],
        "source": {
          "spec": "4.3"
        },
        "section": "5",
        "call": "hexDecode",
        "args": [
          {
            "str": "a\"b\\cA\n"
          }
        ],
        "expect": {
          "null": true
        }
      },
      {
        "kind": "vector",
        "id": "V7",
        "title": "concat of a bytes literal and a labelled value",
        "covers": ["R-ENC-LEN"],
        "source": {
          "cite": {
            "source": "rfc4648",
            "section": "10"
          }
        },
        "call": "hexEncode",
        "args": [
          {
            "concat": [
              {
                "hex": "00"
              },
              {
                "hex": "ff",
                "label": "Key"
              }
            ]
          }
        ],
        "expect": {
          "str": "00ff"
        }
      },
      {
        "kind": "vector",
        "id": "V8",
        "title": "labelled argument",
        "covers": ["R-ENC-DIGITS"],
        "source": {
          "command": "echo 0b0b0b"
        },
        "section": "5",
        "call": "hexEncode",
        "args": [
          {
            "hex": "0b0b0b",
            "label": "Key"
          }
        ],
        "expect": {
          "str": "0b0b0b"
        }
      },
      {
        "kind": "vector",
        "id": "V9",
        "title": "mixed case decodes to bytes",
        "covers": ["R-ROUND-TRIP"],
        "source": {
          "command": "python3 -c 'print(bytes.fromhex(\"aBcD\").hex())'"
        },
        "section": "5",
        "call": "hexDecode",
        "args": [
          {
            "str": "aBcD"
          }
        ],
        "expect": {
          "hex": "abcd"
        }
      },
      {
        "kind": "vector",
        "id": "V10",
        "title": "several characters as ascii",
        "covers": ["R-ROUND-TRIP"],
        "source": {
          "cite": {
            "source": "rfc4648",
            "section": "10"
          }
        },
        "call": "hexDecode",
        "args": [
          {
            "str": "666f6f"
          }
        ],
        "expect": {
          "ascii": "foo"
        }
      },
      {
        "kind": "property",
        "id": "P-ENC-LEN",
        "title": "two characters per byte",
        "covers": ["R-ENC-LEN", "R-ENC-DIGITS"],
        "forall": [
          {
            "name": "b",
            "type": "bytes",
            "minLen": 0,
            "maxLen": 64
          }
        ],
        "assert": {
          "op": "==",
          "args": [
            {
              "op": "strLen",
              "args": [
                {
                  "call": "hexEncode",
                  "args": [
                    {
                      "var": "b"
                    }
                  ]
                }
              ]
            },
            {
              "op": "*",
              "args": [
                {
                  "int": 2
                },
                {
                  "op": "len",
                  "args": [
                    {
                      "var": "b"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "kind": "property",
        "id": "P-ENC-LOWER",
        "title": "output is lowercase",
        "covers": ["R-ENC-DIGITS"],
        "forall": [
          {
            "name": "b",
            "type": "bytes",
            "minLen": 0,
            "maxLen": 64
          },
          {
            "name": "t",
            "type": "string",
            "minLen": 0,
            "maxLen": 32,
            "alphabet": ["hexdigit", "HEXDIGIT"]
          }
        ],
        "where": {
          "op": "==",
          "args": [
            {
              "op": "%",
              "args": [
                {
                  "op": "strLen",
                  "args": [
                    {
                      "var": "t"
                    }
                  ]
                },
                {
                  "int": 2
                }
              ]
            },
            {
              "int": 0
            }
          ]
        },
        "assert": {
          "let": [
            {
              "name": "e",
              "value": {
                "call": "hexEncode",
                "args": [
                  {
                    "var": "b"
                  }
                ]
              }
            }
          ],
          "in": {
            "op": "==",
            "args": [
              {
                "var": "e"
              },
              {
                "op": "lower",
                "args": [
                  {
                    "var": "e"
                  }
                ]
              }
            ]
          }
        }
      },
      {
        "kind": "property",
        "id": "P-DEC-ODD",
        "title": "odd-length text is rejected",
        "covers": ["R-DEC-REJECT"],
        "forall": [
          {
            "name": "t",
            "type": "string",
            "minLen": 1,
            "maxLen": 33,
            "alphabet": ["hexdigit"]
          }
        ],
        "assert": {
          "op": "implies",
          "args": [
            {
              "op": "==",
              "args": [
                {
                  "op": "%",
                  "args": [
                    {
                      "op": "strLen",
                      "args": [
                        {
                          "var": "t"
                        }
                      ]
                    },
                    {
                      "int": 2
                    }
                  ]
                },
                {
                  "int": 1
                }
              ]
            },
            {
              "op": "isNull",
              "args": [
                {
                  "call": "hexDecode",
                  "args": [
                    {
                      "var": "t"
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "kind": "property",
        "id": "P-DEC-OTHER",
        "title": "any other character is refused",
        "covers": ["R-DEC-REJECT"],
        "forall": [
          {
            "name": "a",
            "type": "string",
            "minLen": 0,
            "maxLen": 16,
            "alphabet": ["hexdigit", "HEXDIGIT"]
          },
          {
            "name": "x",
            "type": "string",
            "minLen": 1,
            "maxLen": 1,
            "alphabet": ["g", "G", " ", "\"", "x"]
          },
          {
            "name": "z",
            "type": "string",
            "minLen": 0,
            "maxLen": 16,
            "alphabet": ["hexdigit", "HEXDIGIT"]
          }
        ],
        "where": {
          "op": "==",
          "args": [
            {
              "op": "%",
              "args": [
                {
                  "op": "strLen",
                  "args": [
                    {
                      "op": "strConcat",
                      "args": [
                        {
                          "var": "a"
                        },
                        {
                          "op": "strConcat",
                          "args": [
                            {
                              "var": "x"
                            },
                            {
                              "var": "z"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "int": 2
                }
              ]
            },
            {
              "int": 0
            }
          ]
        },
        "assert": {
          "op": "isNull",
          "args": [
            {
              "call": "hexDecode",
              "args": [
                {
                  "op": "strConcat",
                  "args": [
                    {
                      "var": "a"
                    },
                    {
                      "op": "strConcat",
                      "args": [
                        {
                          "var": "x"
                        },
                        {
                          "var": "z"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      },
      {
        "kind": "property",
        "id": "P-ROUND-TRIP",
        "title": "hexDecode(hexEncode(b)) is b",
        "covers": ["R-ROUND-TRIP"],
        "forall": [
          {
            "name": "b",
            "type": "bytes",
            "minLen": 0,
            "maxLen": 64
          }
        ],
        "assert": {
          "let": [
            {
              "name": "d",
              "value": {
                "call": "hexDecode",
                "args": [
                  {
                    "call": "hexEncode",
                    "args": [
                      {
                        "var": "b"
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "in": {
            "op": "and",
            "args": [
              {
                "op": "notNull",
                "args": [
                  {
                    "var": "d"
                  }
                ]
              },
              {
                "op": "==",
                "args": [
                  {
                    "op": "unwrap",
                    "args": [
                      {
                        "var": "d"
                      }
                    ]
                  },
                  {
                    "var": "b"
                  }
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "locator": {
    "file": "test/fixtures/profile/profile-hex.xml",
    "root": 10,
    "at": {
      "R-ENC-LEN": 55,
      "R-ENC-DIGITS": 63,
      "R-DEF-DIGIT": 75,
      "R-RFC-VECTORS": 76,
      "R-DEC-REJECT": 88,
      "R-DEC-EMPTY": 106,
      "R-ROUND-TRIP": 110,
      "exclusion §10": 80,
      "exclusion §4.5": 121,
      "V1": 141,
      "V2": 152,
      "V3": 163,
      "V4": 174,
      "V5": 185,
      "V6": 196,
      "V7": 207,
      "V8": 218,
      "V9": 229,
      "V10": 240,
      "P-ENC-LEN": 57,
      "P-ENC-LOWER": 65,
      "P-DEC-ODD": 91,
      "P-DEC-OTHER": 95,
      "P-ROUND-TRIP": 112,
      "hexEncode": 47,
      "hexDecode": 48
    }
  }
}
