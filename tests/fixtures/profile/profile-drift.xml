    <section anchor="interface">
      <name>Interface</name>
      <sourcecode type="ts-interface"><![CDATA[
// module: nish/hex
export const hexEncode = (bytes: u8[]): string
export function hexDecode(text: string): u8[] | null
]]></sourcecode>
    </section>
    <section anchor="encoding">
      <name>Encoding</name>
      <section anchor="length">
        <name>Length</name>
        <t anchor="R-ENC-LEN">hexEncode <bcp14>MUST</bcp14> return exactly two characters per input byte.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ENC-LEN covers R-ENC-LEN, R-ENC-DIGITS — two characters per byte
forall (b: u8[] /* 0..64 */) => hexEncode(b).length === 2 * b.length
]]></sourcecode>
      </section>
      <section anchor="digits">
        <name>Digits</name>
        <t anchor="R-ENC-DIGITS">Each byte <bcp14>MUST</bcp14> be written high nibble first, using the digits 0-9 and a-f.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ENC-LOWER covers R-ENC-DIGITS — output is lowercase
forall (b: u8[] /* 0..64 */, t: string /* 0..32 hexdigit HEXDIGIT */) => { const e = hexEncode(b); return e === e.toLowerCase(); }
where t.length % 2 === 0
]]></sourcecode>
      </section>
    </section>
    <section anchor="decoding">
      <name>Decoding</name>
      <section anchor="accepted-input">
        <name>Accepted input</name>
        <t anchor="R-DEF-DIGIT">Definition: a hex digit is one of the characters 0-9, a-f and A-F.</t>
        <blockquote anchor="R-RFC-VECTORS">
          <t>BASE16("f") = "66"
<xref section="10" sectionFormat="of" target="RFC4648"/></t>
        </blockquote>
        <blockquote anchor="R-RFC-UPPER">
          <t>BASE16("fo") = "666F"
<xref section="10" sectionFormat="of" target="RFC4648"/></t>
        </blockquote>
        <t>Untested: the reference prints uppercase digits. Checked by: R-ENC-DIGITS.</t>
      </section>
      <section anchor="rejected-input">
        <name>Rejected input</name>
        <t anchor="R-DEC-REJECT">hexDecode <bcp14>MUST</bcp14> return null when the text has an odd length or contains any
other character, including whitespace and a "0x" prefix.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-DEC-ODD covers R-DEC-REJECT — odd-length text is rejected
forall (t: string /* 1..33 hexdigit */) => implies(t.length % 2 === 1, hexDecode(t) === null)
]]></sourcecode>
        <sourcecode type="ts-property"><![CDATA[
// P-DEC-OTHER covers R-DEC-REJECT — any other character is refused
forall (
  a: string /* 0..16 hexdigit HEXDIGIT */,
  x: string /* 1..1 "gG \"x" */,
  z: string /* 0..16 hexdigit HEXDIGIT */,
) => hexDecode(a + (x + z)) === null
where (a + (x + z)).length % 2 === 0
]]></sourcecode>
      </section>
      <section anchor="empty-input">
        <name>Empty input</name>
        <t anchor="R-DEC-EMPTY">hexDecode of the empty string <bcp14>MUST</bcp14> return an empty array, not null.</t>
      </section>
      <section anchor="round-trip">
        <name>Round trip</name>
        <t anchor="R-ROUND-TRIP">For all bytes b, hexDecode(hexEncode(b)) <bcp14>MUST</bcp14> equal b.</t>
        <sourcecode type="ts-property"><![CDATA[
// P-ROUND-TRIP covers R-ROUND-TRIP — hexDecode(hexEncode(b)) is b
forall (b: u8[] /* 0..64 */) => {
  const d = hexDecode(hexEncode(b));
  return d !== null && unwrap(d) === b;
}
]]></sourcecode>
      </section>
      <section anchor="timing">
        <name>Timing</name>
        <t anchor="R-DEC-TIMING">hexDecode <bcp14>MUST NOT</bcp14> index a table by the value of a digit.</t>
        <t>Untested: timing is not observable from a unit test. Checked by: code review.</t>
        <t>Callers <bcp14>SHOULD NOT</bcp14> decode secrets with this module.</t>
        <t>Untested: an obligation on the caller.</t>
      </section>
