{
  "$schema": "../../../schemas/rfc-contract.json",
  "contract": "profile-iterate",
  "source": {
    "rfc": 7748,
    "title": "Profile fixture: vectors that iterate their call",
    "sha256": "b3247a6ab5df766d2e4cc64c14bd4ce832d8bc56cd8b126e60037b32f708a536"
