    <section anchor="interface">
      <name>Interface</name>
      <sourcecode type="ts-interface"><![CDATA[
// module: nish/crypto/chacha20poly1305
export const chacha20Block = (key: u8[], counter: u32, nonce: u8[]): u8[] | null
export const poly1305 = (key: u8[], msg: u8[]): u8[] | null
]]></sourcecode>
