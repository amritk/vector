  "requirements": [
    {
      "id": "R-BLOCK",
      "source": "rfc8439",
      "section": "2.3",
      "level": "DEFINITION",
      "quote": "The output is 64 random-looking bytes."
    },
    {
      "id": "R-POLY",
      "source": "rfc8439",
      "section": "2.5",
      "level": "DEFINITION",
      "quote": "Poly1305 takes a 32-byte one-time key and a message and produces a 16-byte tag."
    }
  ],
  "exclusions": [],
