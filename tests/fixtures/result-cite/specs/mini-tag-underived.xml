  <middle>
    <section anchor="interface">
      <name>Interface</name>
      <sourcecode type="ts-interface"><![CDATA[
// module: nish/mini/tag
export function tag(key: u8[], msg: u8[]): u8[]
export function check(key: u8[], msg: u8[], t: u8[]): boolean
]]></sourcecode>
    </section>
    <section anchor="checking">
      <name>Checking</name>
      <blockquote anchor="R-CHECK">
        <t>A receiver MUST check each tag against its key and message. <xref section="2" sectionFormat="of" target="RFC9992"/></t>
      </blockquote>
      <sourcecode type="ts-property"><![CDATA[
// P-CHECK covers R-CHECK — a tag checks against the key and message it was made of
forall (key: u8[] /* 1..1 */, msg: u8[] /* 0..0 */) => check(key, msg, tag(key, msg)) === true
]]></sourcecode>
    </section>
