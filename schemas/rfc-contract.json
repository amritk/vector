{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RfcContract",
  "description": "What an RFC requires of a set of functions: verbatim requirements, the functions' signatures, and the clauses (RFC test vectors and properties) that check them. Checked against the RFC text by `vector rfc check`, then compiled to a Nish test.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A stable id, e.g. rfc5869-hkdf-sha256."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rfc": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "required": ["rfc", "title"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "The module under test as the test imports it, e.g. nish/crypto/hkdf."
        }
      },
      "required": ["module"]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/vectorClause"
          },
          {
            "$ref": "#/$defs/propertyClause"
          }
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "description": "Normative (MUST/SHALL/REQUIRED) sentences deliberately not tested, each with its reason. Every such sentence of the RFC must be a requirement or an exclusion."
    }
  },
  "required": [
    "contract",
    "source",
    "target",
    "requirements",
    "functions",
    "clauses"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "section": {
      "type": "string",
      "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Z](?:\\.\\d+)*)$",
      "description": "An RFC section number: 2.3, A.1, 4."
    },
    "valueType": {
      "enum": ["bytes", "bytes?", "i32", "u32", "bool"],
      "description": "bytes? is bytes or null (a refusal)."
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "level": {
          "enum": [
            "MUST",
            "MUST NOT",
            "REQUIRED",
            "SHALL",
            "SHALL NOT",
            "SHOULD",
            "SHOULD NOT",
            "RECOMMENDED",
            "MAY",
            "OPTIONAL",
            "DEFINITION"
          ],
          "description": "The BCP 14 keyword, or DEFINITION for what the algorithm is."
        },
        "quote": {
          "type": "string",
          "description": "Verbatim from the section (whitespace may differ). Never paraphrase."
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["id", "section", "level", "quote"]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": {
          "$ref": "#/$defs/section"
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["section", "quote", "reason"]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "module": {
          "type": "string",
          "description": "Only for a reference function from another module."
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "type": {
                "$ref": "#/$defs/valueType"
              }
            },
            "required": ["name", "type"]
          }
        },
        "returns": {
          "$ref": "#/$defs/valueType"
        }
      },
      "required": ["name", "params", "returns"]
    },
    "literal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "description": "Lowercase hex, exactly as the RFC prints the bytes (separators removed)."
            },
            "repeat": {
              "type": "integer",
              "minimum": 1
            },
            "unchecked": {
              "type": "string",
              "description": "Why this value is not printed in the cited section. Only when unavoidable; reported as a warning."
            }
          },
          "required": ["hex"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ascii": {
              "type": "string"
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["ascii"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "int": {
              "type": "integer"
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["int"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": ["bool"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "null": {
              "const": true
            }
          },
          "required": ["null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          },
          "required": ["concat"]
        }
      ]
    },
    "expr": {
      "anyOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            }
          },
          "required": ["var"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["call", "args"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "len",
                "concat",
                "slice",
                "zeros",
                "fill",
                "flipBit",
                "unwrap",
                "isNull",
                "notNull",
                "+",
                "-",
                "*",
                "%",
                "le64",
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!=",
                "and",
                "or",
                "not",
                "implies"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["op", "args"],
          "description": "len(bytes)->i32; concat(bytes,bytes); slice(bytes,from,to) clamped; zeros(n); fill(byte,n); flipBit(bytes,bit); unwrap(bytes?)->bytes (a null fails the sample); isNull/notNull(bytes?); + - * % on i32; le64(i32)->8 bytes; comparisons; == != on i32, bool or bytes/bytes?/null; and/or (2+), not, implies."
        }
      ]
    },
    "vectorClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "A known answer printed in the RFC: call(args) == expect. Every value must be printed in `section`.",
      "properties": {
        "kind": {
          "const": "vector"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "call": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "expect": {
          "$ref": "#/$defs/literal"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "covers",
        "section",
        "call",
        "args",
        "expect"
      ]
    },
    "propertyClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "For all inputs in the domain (and `where`), `assert` holds. Z3 picks boundary samples; a seeded PRNG adds random ones.",
      "properties": {
        "kind": {
          "const": "property"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "forall": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "i32"
                  },
                  "min": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  }
                },
                "required": ["name", "type", "min", "max"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "bytes"
                  },
                  "minLen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLen": {
                    "type": "integer",
                    "maximum": 4096
                  }
                },
                "required": ["name", "type", "minLen", "maxLen"]
              }
            ]
          }
        },
        "where": {
          "$ref": "#/$defs/expr",
          "description": "Pure (no calls): restricts the domain."
        },
        "assert": {
          "$ref": "#/$defs/expr"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": ["kind", "id", "title", "covers", "forall", "assert"]
    }
  }
}
