{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RfcContract",
  "description": "What a specification (an RFC, or markdown with numbered headings) requires of a set of functions: verbatim requirements, the functions' signatures, and the clauses (test vectors and properties) that check them. Checked against the spec text by `vector spec check`, then compiled to a Nish test.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A stable id, e.g. rfc5869-hkdf-sha256."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "rfc alone: a single-RFC contract; `sources` may then add sources or declare rfc<N> itself. Or give `main` (the source the completeness gate reads) and `sources` instead of rfc.",
      "properties": {
        "rfc": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "main": {
          "$ref": "#/$defs/id",
          "description": "The id of the main entry of `sources`."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The sha256 of the main source file's bytes. `vector spec frozen` fails when the file on disk differs; other sources are not checked."
        }
      },
      "required": ["title"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceDecl"
      },
      "description": "The documents the contract cites, by id. Citations name one with `source` (default: the main one)."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "The module under test as the test imports it, e.g. nish/crypto/hkdf."
        }
      },
      "required": ["module"]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/vectorClause"
          },
          {
            "$ref": "#/$defs/propertyClause"
          }
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "description": "Normative (MUST/SHALL/REQUIRED) sentences deliberately not tested, each with its reason. Every such sentence of the RFC must be a requirement or an exclusion."
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "reason"]
      },
      "description": "Exports of the target module the contract deliberately does not test, each with its reason. `vector spec exports` fails when a diff adds or changes an export that is neither a tested function nor listed here. A tested function cannot be listed."
    },
    "allowSurvivors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the nish root, e.g. std/crypto/hkdf.ts."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["file", "line", "reason"]
      },
      "description": "Lines whose surviving mutants `vector spec mutate` accepts, each with its reason."
    }
  },
  "required": [
    "contract",
    "source",
    "target",
    "requirements",
    "functions",
    "clauses"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "section": {
      "type": "string",
      "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Z](?:\\.\\d+)*)$",
      "description": "A section number: 2.3, A.1, 4 (an RFC's, or a markdown spec's numbered heading)."
    },
    "paramType": {
      "enum": [
        "bytes",
        "bytes?",
        "string",
        "string?",
        "i32",
        "u32",
        "bool",
        "secret-bytes"
      ],
      "description": "bytes? is bytes or null (a refusal). secret-bytes is a nish Secret<u8[]>: bytes in the contract, wrapped with secret() by the generated test."
    },
    "returnType": {
      "enum": [
        "bytes",
        "bytes?",
        "string",
        "string?",
        "i32",
        "u32",
        "bool",
        "secret-bytes",
        "secret-bytes?"
      ],
      "description": "As paramType; secret-bytes? is a Secret<u8[]> or null, read with expose()."
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "level": {
          "enum": [
            "MUST",
            "MUST NOT",
            "REQUIRED",
            "SHALL",
            "SHALL NOT",
            "SHOULD",
            "SHOULD NOT",
            "RECOMMENDED",
            "MAY",
            "OPTIONAL",
            "DEFINITION"
          ],
          "description": "The BCP 14 keyword, or DEFINITION for what the algorithm is."
        },
        "quote": {
          "type": "string",
          "description": "Verbatim from the section (whitespace may differ). Never paraphrase."
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["id", "section", "level", "quote"]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["section", "quote", "reason"]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "module": {
          "type": "string",
          "description": "Only for a reference function from another module."
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "type": {
                "$ref": "#/$defs/paramType"
              }
            },
            "required": ["name", "type"]
          }
        },
        "returns": {
          "$ref": "#/$defs/returnType"
        }
      },
      "required": ["name", "params", "returns"]
    },
    "literal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "description": "Lowercase hex, exactly as the RFC prints the bytes (separators removed)."
            },
            "repeat": {
              "type": "integer",
              "minimum": 1
            },
            "unchecked": {
              "type": "string",
              "description": "Why this value is not printed in the cited section. Only when unavoidable; reported as a warning."
            }
          },
          "required": ["hex"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ascii": {
              "type": "string"
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["ascii"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "str": {
              "type": "string",
              "pattern": "^[\\x20-\\x7e\\t\\n\\r]*$",
              "description": "A string value: printable ASCII, tab, LF and CR."
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["str"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "int": {
              "type": "integer"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "[A-Za-z]",
              "description": "The name the RFC prints right before the value (`L = 42`, `Block Count: 1`); fidelity checks the pair. Without one the int is unchecked and reported as a warning."
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["int"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": ["bool"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "null": {
              "const": true
            }
          },
          "required": ["null"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          },
          "required": ["concat"]
        }
      ]
    },
    "expr": {
      "anyOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            }
          },
          "required": ["var"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["call", "args"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "len",
                "concat",
                "slice",
                "zeros",
                "fill",
                "flipBit",
                "unwrap",
                "isNull",
                "notNull",
                "+",
                "-",
                "*",
                "%",
                "le64",
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!=",
                "and",
                "or",
                "not",
                "implies",
                "strLen",
                "strConcat",
                "lower",
                "upper",
                "utf8",
                "ascii",
                "charAt"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["op", "args"],
          "description": "len(bytes)->i32; concat(bytes,bytes); slice(bytes,from,to) clamped; zeros(n); fill(byte,n); flipBit(bytes,bit); unwrap(bytes?)->bytes (a null fails the sample); isNull/notNull(bytes?); + - * % on i32; le64(i32)->8 bytes; comparisons; == != on i32, bool or bytes/bytes?/null; and/or (2+), not, implies; strLen(string)->i32; strConcat(string,string); lower/upper(string) (ASCII only); utf8(string)->bytes; ascii(bytes)->string? (null when any byte >= 0x80); charAt(string,i32)->string (\"\" out of range); unwrap/isNull/notNull also take string?; == != also on string/string?/null."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Names for values, bound in order (each may use the ones before it), scoped over `in`. Only at the top of an assert (or a let's `in`); a name may not shadow a variable or function.",
          "properties": {
            "let": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "value": {
                    "$ref": "#/$defs/expr"
                  }
                },
                "required": ["name", "value"]
              }
            },
            "in": {
              "$ref": "#/$defs/expr"
            }
          },
          "required": ["let", "in"]
        }
      ]
    },
    "vectorClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "A known answer: call(args) == expect. The args are printed in the cited section (with a cite source) or in `section`; `source` says where the expected value comes from.",
      "properties": {
        "kind": {
          "const": "vector"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/vectorSource"
        },
        "section": {
          "$ref": "#/$defs/section",
          "description": "Only with a command or spec source: the main-source section printing the args."
        },
        "call": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "expect": {
          "$ref": "#/$defs/literal"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "covers",
        "source",
        "call",
        "args",
        "expect"
      ]
    },
    "propertyClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "For all inputs in the domain (and `where`), `assert` holds. Z3 picks boundary samples; a seeded PRNG adds random ones.",
      "properties": {
        "kind": {
          "const": "property"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "forall": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "i32"
                  },
                  "min": {
                    "type": "integer"
                  },
                  "max": {
                    "type": "integer"
                  }
                },
                "required": ["name", "type", "min", "max"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "bytes"
                  },
                  "minLen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLen": {
                    "type": "integer",
                    "maximum": 4096
                  }
                },
                "required": ["name", "type", "minLen", "maxLen"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "string"
                  },
                  "minLen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLen": {
                    "type": "integer",
                    "maximum": 4096
                  },
                  "alphabet": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "Single characters and/or the classes hexdigit, HEXDIGIT, digit, alpha, space, ascii-printable."
                  }
                },
                "required": ["name", "type", "minLen", "maxLen", "alphabet"]
              }
            ]
          }
        },
        "where": {
          "$ref": "#/$defs/expr",
          "description": "Pure (no calls): restricts the domain."
        },
        "assert": {
          "$ref": "#/$defs/expr"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": ["kind", "id", "title", "covers", "forall", "assert"]
    },
    "sourceDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rfc": {
          "type": "integer",
          "description": "An RFC number: rfcs/rfc<N>.txt."
        },
        "path": {
          "type": "string",
          "description": "The spec's file, relative to the contract."
        },
        "file": {
          "type": "string",
          "description": "The file whose bytes were read for this source, relative to the repo root: the directory that holds the contract's directory (contracts/x.json -> its parent), or vector's own root when the file came from there, e.g. rfcs/rfc4648.txt. `vector spec check` fails when it reads another file."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The sha256 of that file's bytes. `vector spec check` and `vector spec frozen` fail when the bytes differ."
        }
      },
      "required": ["id"]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        }
      },
      "required": ["section"]
    },
    "vectorSource": {
      "description": "Where the expected value comes from: printed in a cited section; the stdout of a command (run under --run-sources); or, for an expected null or bool, a section that states it.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cite": {
              "$ref": "#/$defs/citation"
            }
          },
          "required": ["cite"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": ["command"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/section"
            }
          },
          "required": ["spec"]
        }
      ]
    }
  }
}
