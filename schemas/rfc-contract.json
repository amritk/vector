{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RfcContract",
  "description": "What a specification (an RFC, or markdown with numbered headings) requires of a set of functions: verbatim requirements, the functions' signatures, and the clauses (test vectors and properties) that check them. Checked against the spec text by `vector spec check`, then compiled to a test of an implementation. It names no language: it records each construct as precisely as the spec states it, and a language that cannot express one drops that detail.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A stable id, e.g. rfc5869-hkdf-sha256."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "rfc alone: a single-RFC contract; `sources` may then add sources or declare rfc<N> itself. Or give `main` (the source the completeness gate reads) and `sources` instead of rfc.",
      "properties": {
        "rfc": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "main": {
          "$ref": "#/$defs/id",
          "description": "The id of the main entry of `sources`."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The sha256 of the main source file's bytes. `vector spec frozen` fails when the file on disk differs; other sources are not checked."
        }
      },
      "required": ["title"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceDecl"
      },
      "description": "The documents the contract cites, by id. Citations name one with `source` (default: the main one)."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "$ref": "#/$defs/modulePath",
          "description": "The module under test, as a neutral path, e.g. nish/crypto/hkdf. Each language writes it in its own module form unless `modules` overrides it."
        },
        "modules": {
          "$ref": "#/$defs/moduleOverrides"
        }
      },
      "required": ["module"]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/vectorClause"
          },
          {
            "$ref": "#/$defs/propertyClause"
          }
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "description": "Normative (MUST/SHALL/REQUIRED) sentences deliberately not tested, each with its reason. Every such sentence of the RFC must be a requirement or an exclusion."
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "reason"]
      },
      "description": "Exports of the target module the contract deliberately does not test, each with its reason. `vector spec exports` fails when a diff adds or changes an export that is neither a tested function nor listed here. A tested function cannot be listed."
    },
    "allowSurvivors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Relative to the implementation's root, e.g. std/crypto/hkdf.ts."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["file", "line", "reason"]
      },
      "description": "Lines whose surviving mutants `vector spec mutate` accepts, each with its reason."
    }
  },
  "required": [
    "contract",
    "source",
    "target",
    "requirements",
    "functions",
    "clauses"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "section": {
      "type": "string",
      "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Z](?:\\.\\d+)*)$",
      "description": "A section number: 2.3, A.1, 4 (an RFC's, or a markdown spec's numbered heading)."
    },
    "modulePath": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:/[a-z][a-z0-9_]*)+$",
      "description": "A module as a neutral path `<root>/<segment>/…`: lowercase segments separated by `/`, like the segments of a URI path (RFC 3986 §3.3)."
    },
    "moduleOverrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-language override of the module form, keyed by language: how that language names the module when its default form, derived from the neutral path, is wrong. A language not listed uses its default.",
      "properties": {
        "rust": {
          "type": "string",
          "minLength": 1
        },
        "ruby": {
          "type": "string",
          "minLength": 1
        },
        "zig": {
          "type": "string",
          "minLength": 1
        },
        "go": {
          "type": "string",
          "minLength": 1
        },
        "cpp": {
          "type": "string",
          "minLength": 1
        },
        "csharp": {
          "type": "string",
          "minLength": 1
        },
        "c": {
          "type": "string",
          "minLength": 1
        },
        "java": {
          "type": "string",
          "minLength": 1
        },
        "kotlin": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "typescript": {
          "type": "string",
          "minLength": 1
        },
        "php": {
          "type": "string",
          "minLength": 1
        },
        "swift": {
          "type": "string",
          "minLength": 1
        },
        "dart": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nameOverrides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-language override of a name, keyed by language: the name that language uses when its default name rule (its own style guide's, applied to `name`) gives the wrong one. A language not listed uses its rule.",
      "properties": {
        "rust": {
          "type": "string",
          "minLength": 1
        },
        "ruby": {
          "type": "string",
          "minLength": 1
        },
        "zig": {
          "type": "string",
          "minLength": 1
        },
        "go": {
          "type": "string",
          "minLength": 1
        },
        "cpp": {
          "type": "string",
          "minLength": 1
        },
        "csharp": {
          "type": "string",
          "minLength": 1
        },
        "c": {
          "type": "string",
          "minLength": 1
        },
        "java": {
          "type": "string",
          "minLength": 1
        },
        "kotlin": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "typescript": {
          "type": "string",
          "minLength": 1
        },
        "php": {
          "type": "string",
          "minLength": 1
        },
        "swift": {
          "type": "string",
          "minLength": 1
        },
        "dart": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ident": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "intType": {
      "enum": ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64"],
      "description": "A fixed-width integer: iN is two's complement and uN unsigned, N bits wide, as ISO C11 §7.20.1.1 intN_t/uintN_t; + - * wrap modulo 2^N."
    },
    "intValue": {
      "description": "An integer: a JSON integer within ±(2^53−1), or a decimal string for a value beyond it, so 64-bit values are exact (RFC 7493 §2.2, RFC 8259 §6). The string must not be a value a JSON integer could carry; its pattern admits only 16 digits or more, since the exact bound 2^53−1 is beyond a pattern and is the contract validator's to check.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^-?[1-9][0-9]{15,}$"
        }
      ]
    },
    "f64Text": {
      "type": "string",
      "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|NaN|Infinity|-Infinity)$",
      "description": "An IEEE 754-2019 binary64 value as text: a decimal, converted to the nearest double with roundTiesToEven (§4.3.1, §5.12.2), or NaN, Infinity, -Infinity; -0 is negative zero."
    },
    "f64Bound": {
      "type": "string",
      "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?|Infinity|-Infinity)$",
      "description": "An f64Text that is not NaN, for a bound of an f64 domain: NaN is unordered (IEEE 754-2019 §5.11), so it bounds nothing."
    },
    "f64Bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "description": "The IEEE 754-2019 binary64 encoding (§3.4) as 16 lowercase hex digits, most significant first; it is how a NaN's payload is stated, and NaN compares by these bits."
    },
    "paramType": {
      "enum": [
        "bytes",
        "bytes?",
        "string",
        "string?",
        "bool",
        "bool?",
        "f64",
        "f64?",
        "secret-bytes",
        "secret-bytes?",
        "i8",
        "i8?",
        "i16",
        "i16?",
        "i32",
        "i32?",
        "i64",
        "i64?",
        "u8",
        "u8?",
        "u16",
        "u16?",
        "u32",
        "u32?",
        "u64",
        "u64?"
      ],
      "description": "A parameter's type. bytes is an octet string; string is Unicode text, UTF-8 encoded (RFC 3629); f64 is an IEEE 754-2019 binary64; i8 … u64 are the fixed-width integers (see intType); secret-bytes is bytes whose value is secret: a language may wrap them in its own secret type, but in the contract they are bytes. T? as a parameter is an optional input: the argument may be absent, written null."
    },
    "returnType": {
      "enum": [
        "bytes",
        "bytes?",
        "string",
        "string?",
        "bool",
        "bool?",
        "f64",
        "f64?",
        "secret-bytes",
        "secret-bytes?",
        "i8",
        "i8?",
        "i16",
        "i16?",
        "i32",
        "i32?",
        "i64",
        "i64?",
        "u8",
        "u8?",
        "u16",
        "u16?",
        "u32",
        "u32?",
        "u64",
        "u64?"
      ],
      "description": "A result's type, from the types of paramType. T? as a result is a refusing return: the function declines this input and returns no value, written null."
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "level": {
          "enum": [
            "MUST",
            "MUST NOT",
            "REQUIRED",
            "SHALL",
            "SHALL NOT",
            "SHOULD",
            "SHOULD NOT",
            "RECOMMENDED",
            "MAY",
            "OPTIONAL",
            "DEFINITION"
          ],
          "description": "The BCP 14 keyword, or DEFINITION for what the algorithm is."
        },
        "quote": {
          "type": "string",
          "description": "Verbatim from the section (whitespace may differ). Never paraphrase."
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["id", "section", "level", "quote"]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["section", "quote", "reason"]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/ident"
        },
        "module": {
          "$ref": "#/$defs/modulePath",
          "description": "Only for a reference function from another module."
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/ident"
              },
              "type": {
                "$ref": "#/$defs/paramType"
              },
              "names": {
                "$ref": "#/$defs/nameOverrides"
              }
            },
            "required": ["name", "type"]
          }
        },
        "returns": {
          "$ref": "#/$defs/returnType"
        },
        "names": {
          "$ref": "#/$defs/nameOverrides"
        }
      },
      "required": ["name", "params", "returns"]
    },
    "literal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hex": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{2})*$",
              "description": "Lowercase base16 (RFC 4648 §8), exactly as the spec prints the bytes (separators removed)."
            },
            "repeat": {
              "type": "integer",
              "minimum": 1
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "unchecked": {
              "type": "string",
              "description": "Why this value is not printed in the cited section. Only when unavoidable; reported as a warning."
            }
          },
          "required": ["hex"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ascii": {
              "type": "string"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["ascii"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "str": {
              "type": "string",
              "pattern": "^[\\x20-\\x7e\\t\\n\\r]*$",
              "description": "A string value: printable ASCII, tab, LF and CR."
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["str"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "int": {
              "$ref": "#/$defs/intValue"
            },
            "label": {
              "$ref": "#/$defs/label",
              "description": "The name the spec prints right before the value (`L = 42`, `Block Count: 1`); fidelity checks the pair. Without one the int is unchecked and reported as a warning."
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["int"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "A binary64 value. `f64` is its text; `bits`, when given, states its encoding, and must be the encoding `f64` converts to.",
          "properties": {
            "f64": {
              "$ref": "#/$defs/f64Text"
            },
            "bits": {
              "$ref": "#/$defs/f64Bits"
            },
            "label": {
              "$ref": "#/$defs/label"
            },
            "unchecked": {
              "type": "string"
            }
          },
          "required": ["f64"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          },
          "required": ["bool"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "null": {
              "const": true
            }
          },
          "required": ["null"],
          "description": "The absent value of a T?: a refusing return as a result, an absent argument as an optional input."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concat": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/literal"
              }
            }
          },
          "required": ["concat"]
        }
      ]
    },
    "expr": {
      "anyOf": [
        {
          "$ref": "#/$defs/literal"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "var": {
              "type": "string"
            }
          },
          "required": ["var"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "call": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["call", "args"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "enum": [
                "len",
                "concat",
                "slice",
                "zeros",
                "fill",
                "flipBit",
                "xor",
                "bitAnd",
                "bitOr",
                "unwrap",
                "isNull",
                "notNull",
                "+",
                "-",
                "*",
                "%",
                "le64",
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!=",
                "and",
                "or",
                "not",
                "implies",
                "strLen",
                "strConcat",
                "lower",
                "upper",
                "utf8",
                "ascii",
                "charAt"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          },
          "required": ["op", "args"],
          "description": "len(bytes)->i32; concat(bytes,bytes); slice(bytes,from,to) clamped; zeros(n); fill(byte,n); flipBit(bytes,bit); xor/bitAnd/bitOr(bytes,bytes) bytewise, the shorter read as zeros past its end; unwrap(bytes?)->bytes (a null fails the sample); isNull/notNull(bytes?); + - * % on i32; le64(i32)->8 bytes; comparisons; == != on i32, bool or bytes/bytes?/null; and/or (2+), not, implies; strLen(string)->i32; strConcat(string,string); lower/upper(string) (ASCII only); utf8(string)->bytes; ascii(bytes)->string? (null when any byte >= 0x80); charAt(string,i32)->string (\"\" out of range); unwrap/isNull/notNull also take string?; == != also on string/string?/null."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Names for values, bound in order (each may use the ones before it), scoped over `in`. Only at the top of an assert (or a let's `in`); a name may not shadow a variable or function.",
          "properties": {
            "let": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                  },
                  "value": {
                    "$ref": "#/$defs/expr"
                  }
                },
                "required": ["name", "value"]
              }
            },
            "in": {
              "$ref": "#/$defs/expr"
            }
          },
          "required": ["let", "in"]
        }
      ]
    },
    "vectorClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "A known answer: call(args) == expect. The args are printed in the cited section (with a cite source) or in `section`; `source` says where the expected value comes from.",
      "properties": {
        "kind": {
          "const": "vector"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/vectorSource"
        },
        "section": {
          "$ref": "#/$defs/section",
          "description": "Only with a command or spec source: the main-source section printing the args."
        },
        "call": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "expect": {
          "$ref": "#/$defs/literal"
        },
        "tolerance": {
          "$ref": "#/$defs/tolerance"
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "covers",
        "source",
        "call",
        "args",
        "expect"
      ]
    },
    "propertyClause": {
      "type": "object",
      "additionalProperties": false,
      "description": "For all inputs in the domain (and `where`), `assert` holds. Z3 picks boundary samples; a seeded PRNG adds random ones.",
      "properties": {
        "kind": {
          "const": "property"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "forall": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/$defs/intType"
                  },
                  "min": {
                    "$ref": "#/$defs/intValue"
                  },
                  "max": {
                    "$ref": "#/$defs/intValue"
                  }
                },
                "required": ["name", "type", "min", "max"],
                "description": "An integer variable of one width, min..max inclusive, both in that width's range."
              },
              {
                "type": "object",
                "additionalProperties": false,
                "description": "An f64 variable, min..max inclusive. The schema records it; vector does not sample over f64 yet and refuses such a property.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "f64"
                  },
                  "min": {
                    "$ref": "#/$defs/f64Bound"
                  },
                  "max": {
                    "$ref": "#/$defs/f64Bound"
                  }
                },
                "required": ["name", "type", "min", "max"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "bytes"
                  },
                  "minLen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLen": {
                    "type": "integer",
                    "maximum": 4096
                  }
                },
                "required": ["name", "type", "minLen", "maxLen"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "const": "string"
                  },
                  "minLen": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxLen": {
                    "type": "integer",
                    "maximum": 4096
                  },
                  "alphabet": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "Single characters and/or the classes hexdigit, HEXDIGIT, digit, alpha, space, ascii-printable."
                  }
                },
                "required": ["name", "type", "minLen", "maxLen", "alphabet"]
              }
            ]
          }
        },
        "where": {
          "$ref": "#/$defs/expr",
          "description": "Pure (no calls): restricts the domain."
        },
        "assert": {
          "$ref": "#/$defs/expr"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      },
      "required": ["kind", "id", "title", "covers", "forall", "assert"]
    },
    "sourceDecl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "rfc": {
          "type": "integer",
          "description": "An RFC number. Unless `path` is given, its text is rfc<N>.xml, else rfc<N>.txt, beside the contract, in ../rfcs, then in vector's rfcs/; at each place the XML comes first, and a recorded `file` picks between them."
        },
        "path": {
          "type": "string",
          "description": "The spec's file, relative to the contract."
        },
        "file": {
          "type": "string",
          "description": "The file whose bytes were read for this source: its path under rfcs/ or specs/ of the nearest directory holding it there, counting the contract's directory, its ancestors and vector's own root (e.g. rfcs/rfc4648.txt), or, for a file beside the contract, from the directory holding the contract's directory (contracts/x.txt). `vector spec check` fails when it reads another file."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "The sha256 of that file's bytes. `vector spec check` and `vector spec frozen` fail when the bytes differ."
        }
      },
      "required": ["id"]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id",
          "description": "The id of the cited source (default: the main one)."
        },
        "section": {
          "$ref": "#/$defs/section"
        }
      },
      "required": ["section"]
    },
    "vectorSource": {
      "description": "Where the expected value comes from: printed in a cited section; the stdout of a command (run under --run-sources); or, for an expected null or bool, a section that states it.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cite": {
              "$ref": "#/$defs/citation"
            }
          },
          "required": ["cite"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            }
          },
          "required": ["command"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spec": {
              "$ref": "#/$defs/section"
            }
          },
          "required": ["spec"]
        }
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "[A-Za-z]",
      "description": "The name the spec prints right before the value (`Key = 00:01:…`, `L = 42`); fidelity checks the pair."
    },
    "tolerance": {
      "description": "How far an f64 result may be from `expect`: `abs`, an absolute difference as decimal text, or `ulps`, a count of binary64 units in the last place. It must come from the spec: `quote` is the sentence that states it, in `section` (of `source`, default the main one), checked like a requirement's quote. Without a tolerance an f64 expect is compared bit for bit (IEEE 754-2019 §3.4 encodings), so NaN equals a NaN of the same bits. Only an f64 result takes a tolerance, and an expected NaN or infinity is compared bit for bit even with one. `abs` must be finite: decimal text past binary64's largest finite value is refused (IEEE 754-2019 §7.4). `ulps` is at most 2^53−1, so it is exact as a JSON number (RFC 7493 §2.2).",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "abs": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"
            },
            "source": {
              "$ref": "#/$defs/id"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["abs", "section", "quote"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ulps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "$ref": "#/$defs/id"
            },
            "section": {
              "$ref": "#/$defs/section"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["ulps", "section", "quote"]
        }
      ]
    }
  }
}
