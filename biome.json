{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "files": {
    "ignore": [
      ".nish/**",
      ".nish-next/**",
      "dist/**",
      ".z3/**",
      "node_modules/**",
      "contracts/**",
      "specs/**",
      "rfcs/**",
      "schemas/**",
      "tests/fixtures/**",
      "tests/dogfood/**"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noThenProperty": "off"
      },
      "style": {
        "useConst": "error",
        "noVar": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "overrides": [
    {
      "include": ["package.json", ".github/.release-please-manifest.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "include": ["src/**/*.ts", "tests/**/*.ts"],
      "formatter": {
        "lineWidth": 120
      },
      "javascript": {
        "formatter": {
          "semicolons": "asNeeded"
        }
      },
      "linter": {
        "rules": {
          "style": {
            "useImportType": "off",
            "useNumberNamespace": "off"
          }
        }
      }
    }
  ]
}
