{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "vector",
    "description": "Prove small programs correct, and hold implementations to their specs: the guide and the reference."
  },
  "navigation": {
    "header": [
      {
        "type": "link",
        "title": "GitHub",
        "icon": "phosphor/regular/github-logo",
        "to": "https://github.com/amritk/vector",
        "newTab": true
      },
      {
        "type": "link",
        "title": "Reference",
        "icon": "phosphor/regular/book-open",
        "to": "/reference"
      }
    ],
    "routes": {
      "/": {
        "type": "group",
        "title": "vector",
        "children": {
          "/": {
            "type": "page",
            "title": "vector",
            "filepath": "docs/guide/index.md",
            "showInSidebar": false,
            "layout": {
              "toc": false,
              "pageTitle": false,
              "pageActions": false,
              "pageNav": false,
              "lastUpdated": false,
              "feedback": false,
              "fullWidth": true,
              "search": { "position": "header" },
              "colorSchemeToggle": "header"
            }
          },
          "/getting-started": {
            "type": "group",
            "title": "Getting started",
            "icon": "phosphor/regular/rocket-launch",
            "children": {
              "/installation": {
                "type": "page",
                "title": "Installation",
                "filepath": "docs/guide/getting-started/installation.md"
              },
              "/first-proof": {
                "type": "page",
                "title": "Your first proof",
                "filepath": "docs/guide/getting-started/first-proof.md"
              }
            }
          },
          "/reference": {
            "type": "group",
            "title": "Reference",
            "children": {
              "/": {
                "type": "page",
                "title": "Overview",
                "filepath": "docs/reference/index.md"
              },
              "/command-line": {
                "type": "group",
                "title": "Command line",
                "children": {
                  "/": {
                    "type": "page",
                    "title": "Overview",
                    "filepath": "docs/reference/command-line.md"
                  },
                  "/verify": {
                    "type": "page",
