                    "filepath": "docs/reference/modules/main.md"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "assetsDir": "docs/site",
  "siteConfig": {
    "isPrivate": true,
    "agent": { "enabled": false },
    "theme": "docs/site/theme.css",
    "logo": {
      "lightMode": "docs/site/logo-light.svg",
      "darkMode": "docs/site/logo-dark.svg"
    },
    "head": {
      "links": [{ "rel": "icon", "type": "image/svg+xml", "href": "/mark.svg" }]
    }
  }
}
