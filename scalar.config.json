                  },
                  "/spec-stale": {
                    "type": "page",
                    "title": "vector spec stale",
                    "filepath": "docs/reference/command-line/spec-stale.md"
                  },
                  "/spec-exports": {
                    "type": "page",
                    "title": "vector spec exports",
                    "filepath": "docs/reference/command-line/spec-exports.md"
                  },
                  "/spec-mutate": {
                    "type": "page",
                    "title": "vector spec mutate",
                    "filepath": "docs/reference/command-line/spec-mutate.md"
                  }
