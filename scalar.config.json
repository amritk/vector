                    "filepath": "docs/reference/modules/cli/spec-extract.md"
                  },
                  "/cli-spec-frozen": {
                    "type": "page",
                    "title": "cli/spec-frozen",
                    "filepath": "docs/reference/modules/cli/spec-frozen.md"
                  },
                  "/cli-spec-mutate": {
                    "type": "page",
                    "title": "cli/spec-mutate",
                    "filepath": "docs/reference/modules/cli/spec-mutate.md"
                  },
                  "/cli-spec-run": {
                    "type": "page",
                    "title": "cli/spec-run",
                    "filepath": "docs/reference/modules/cli/spec-run.md"
                  },
                  "/cli-spec-stale": {
                    "type": "page",
                    "title": "cli/spec-stale",
                    "filepath": "docs/reference/modules/cli/spec-stale.md"
                  },
                  "/cli-verify": {
                    "type": "page",
                    "title": "cli/verify",
                    "filepath": "docs/reference/modules/cli/verify.md"
                  },
                  "/core-diag": {
                    "type": "page",
                    "title": "core/diag",
                    "filepath": "docs/reference/modules/core/diag.md"
                  },
                  "/core-fs": {
                    "type": "page",
                    "title": "core/fs",
                    "filepath": "docs/reference/modules/core/fs.md"
                  },
                  "/core-hex": {
                    "type": "page",
                    "title": "core/hex",
                    "filepath": "docs/reference/modules/core/hex.md"
                  },
                  "/core-json": {
                    "type": "page",
                    "title": "core/json",
                    "filepath": "docs/reference/modules/core/json.md"
                  },
                  "/core-process": {
                    "type": "page",
                    "title": "core/process",
                    "filepath": "docs/reference/modules/core/process.md"
                  },
                  "/core-smt": {
                    "type": "page",
                    "title": "core/smt",
                    "filepath": "docs/reference/modules/core/smt.md"
                  },
                  "/core-z3": {
                    "type": "page",
