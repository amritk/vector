                    "filepath": "docs/reference/command-line/diff.md"
                  },
                  "/spec-extract": {
                    "type": "page",
                    "title": "vector spec extract",
                    "filepath": "docs/reference/command-line/spec-extract.md"
                  },
                  "/spec-check": {
                    "type": "page",
                    "title": "vector spec check",
                    "filepath": "docs/reference/command-line/spec-check.md"
                  },
                  "/spec-emit": {
                    "type": "page",
                    "title": "vector spec emit",
                    "filepath": "docs/reference/command-line/spec-emit.md"
