    <title abbrev="vector/lang/names">vector/lang/names — naming a contract's functions in each language</title>
    <seriesInfo name="Internet-Draft" value="draft-vector-lang-names-00"/>
    <author initials="V." surname="Authors" fullname="Vector Authors">
