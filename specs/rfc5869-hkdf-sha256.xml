    <title abbrev="nish/crypto/hkdf">HMAC-based Extract-and-Expand Key Derivation Function (HKDF)</title>
    <seriesInfo name="Internet-Draft" value="draft-rfc5869-hkdf-sha256-00"/>
    <author initials="V." surname="Authors" fullname="Vector Authors">
      <organization>vector</organization>
