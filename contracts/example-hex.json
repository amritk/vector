{
  "$schema": "../schemas/rfc-contract.json",
  "contract": "example-hex",
  "source": {
    "title": "Spec 0001: nish/hex — hexadecimal encoding and decoding",
    "main": "example-hex",
    "sha256": "53d05a63046cabd83306283215e99fe5b2ba9eabc9b8b795da1ec396f9e69411"
  },
  "sources": [
    {
      "id": "example-hex",
      "path": "../specs/example-hex.md"
    },
    {
      "id": "rfc4648",
      "rfc": 4648,
      "path": "../rfcs/rfc4648.txt"
    }
  ],
  "target": {
    "module": "nish/hex"
  },
  "requirements": [
    {
      "id": "R-ENC-LEN",
      "section": "3.1",
      "level": "MUST",
      "quote": "hexEncode MUST return exactly two characters per input byte."
    },
    {
      "id": "R-ENC-DIGITS",
      "section": "3.2",
      "level": "MUST",
      "quote": "Each byte MUST be written high nibble first, using the digits 0-9 and a-f."
    },
    {
      "id": "R-ENC-ONLY",
      "section": "3.2",
      "level": "MUST NOT",
      "quote": "hexEncode MUST NOT emit uppercase digits, separators or a prefix."
    },
    {
      "id": "R-DEC-ACCEPT",
      "section": "4.1",
      "level": "MUST",
      "quote": "hexDecode MUST accept the digits 0-9, a-f and A-F, in any mix of case."
    },
    {
      "id": "R-DEC-REJECT",
      "section": "4.2",
      "level": "MUST",
      "quote": "hexDecode MUST return null when the text has an odd length or contains any other character, including whitespace and a \"0x\" prefix."
    },
    {
      "id": "R-DEC-EMPTY",
      "section": "4.3",
      "level": "MUST",
      "quote": "hexDecode of the empty string MUST return an empty array, not null."
    },
    {
      "id": "R-ROUND-TRIP",
      "section": "4.4",
      "level": "MUST",
      "quote": "For all bytes b, hexDecode(hexEncode(b)) MUST equal b."
    }
  ],
  "exclusions": [
    {
      "section": "5",
      "quote": "hexDecode MUST NOT index a table by the value of a digit, so that its running time depends only on the length of its input.",
      "reason": "A constraint on how hexDecode is written and on its timing, not on what it returns: no functional test observes a table lookup or a data-dependent running time. Review the implementation for it."
    }
  ],
  "functions": [
    {
      "name": "hexEncode",
      "params": [
        {
          "name": "bytes",
          "type": "bytes"
        }
      ],
      "returns": "string"
    },
    {
      "name": "hexDecode",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "returns": "bytes?"
    }
  ],
  "clauses": [
    {
      "kind": "vector",
      "id": "V1",
      "title": "RFC 4648 §10: BASE16(\"\") = \"\" decodes to the empty array",
      "covers": ["R-DEC-EMPTY"],
      "source": {
        "cite": {
          "source": "rfc4648",
          "section": "10"
        }
      },
      "call": "hexDecode",
      "args": [
        {
          "str": ""
        }
      ],
      "expect": {
        "ascii": ""
      }
    },
    {
      "kind": "vector",
      "id": "V2",
      "title": "RFC 4648 §10: BASE16(\"f\") = \"66\" decodes back",
      "covers": ["R-DEC-ACCEPT", "R-ROUND-TRIP"],
      "source": {
        "cite": {
          "source": "rfc4648",
          "section": "10"
        }
      },
      "call": "hexDecode",
      "args": [
        {
          "str": "66"
        }
      ],
      "expect": {
        "ascii": "f"
      }
    },
    {
      "kind": "vector",
      "id": "V3",
      "title": "RFC 4648 §10: uppercase \"666F6F\" decodes to \"foo\"",
      "covers": ["R-DEC-ACCEPT"],
      "source": {
        "cite": {
          "source": "rfc4648",
          "section": "10"
        }
      },
      "call": "hexDecode",
      "args": [
        {
          "str": "666F6F"
        }
      ],
      "expect": {
        "ascii": "foo"
      }
    },
    {
      "kind": "vector",
      "id": "V4",
      "title": "RFC 4648 §10: uppercase \"666F626172\" decodes to \"foobar\"",
      "covers": ["R-DEC-ACCEPT"],
      "source": {
        "cite": {
          "source": "rfc4648",
          "section": "10"
        }
      },
      "call": "hexDecode",
      "args": [
        {
          "str": "666F6F626172"
        }
      ],
      "expect": {
        "ascii": "foobar"
      }
    },
    {
      "kind": "vector",
      "id": "V5",
      "title": "every nibble boundary, encoded high nibble first in lowercase",
      "covers": ["R-ENC-LEN", "R-ENC-DIGITS", "R-ENC-ONLY"],
      "source": {
        "command": "python3 -c 'print(bytes([0,15,240,255]).hex())'"
      },
      "section": "6",
      "call": "hexEncode",
      "args": [
        {
          "hex": "000ff0ff"
        }
      ],
      "expect": {
        "str": "000ff0ff"
      }
    },
    {
      "kind": "vector",
      "id": "V6",
      "title": "mixed case decodes",
      "covers": ["R-DEC-ACCEPT"],
      "source": {
        "command": "python3 -c 'print(bytes.fromhex(\"aBcD\").hex())'"
      },
      "section": "6",
      "call": "hexDecode",
      "args": [
        {
          "str": "aBcD"
        }
      ],
      "expect": {
        "hex": "abcd"
      }
    },
    {
      "kind": "vector",
      "id": "V7",
      "title": "an odd length is refused with null",
      "covers": ["R-DEC-REJECT"],
      "source": {
