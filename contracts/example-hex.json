      "forall": [
        {
          "name": "b",
          "type": "bytes",
          "minLen": 0,
          "maxLen": 64
        }
      ],
      "assert": {
        "let": [
          {
            "name": "d",
            "value": {
              "call": "hexDecode",
              "args": [
                {
                  "call": "hexEncode",
                  "args": [
                    {
                      "var": "b"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "in": {
          "op": "and",
          "args": [
            {
              "op": "notNull",
              "args": [
                {
                  "var": "d"
                }
              ]
            },
            {
              "op": "==",
              "args": [
                {
                  "op": "unwrap",
                  "args": [
                    {
                      "var": "d"
                    }
                  ]
                },
                {
                  "var": "b"
                }
              ]
            }
          ]
        }
      }
