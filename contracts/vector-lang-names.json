{
  "$schema": "../schemas/rfc-contract.json",
  "contract": "vector-lang-names",
  "source": {
    "title": "vector/lang/names — naming a contract's functions in each language",
    "main": "vector-lang-names",
    "sha256": "31478f6e1540a86b25a29fe852eade36314c6e0a174289ece00db0f0bfc38a5f"
  },
  "sources": [
    {
      "id": "vector-lang-names",
      "path": "../specs/vector-lang-names.xml"
    }
  ],
  "target": {
    "module": "vector/lang/names"
  },
  "requirements": [
    {
      "id": "R-WORDS",
      "section": "3",
      "level": "MUST",
      "quote": "A name MUST be split into words at each underscore, at each step from a lowercase letter or digit to a capital, and before the last capital of a run of two or more capitals that a lowercase letter follows; a run of digits MUST stay with the word before it, and every letter MUST be kept."
    },
    {
      "id": "R-SNAKE",
      "section": "4.1",
      "level": "MUST",
      "quote": "For rust, ruby, cpp, c and python, and for zig's parameters, langName MUST return the words in lowercase, joined by underscores."
    },
    {
      "id": "R-CAMEL",
      "section": "4.2",
      "level": "MUST",
      "quote": "For java and typescript, and for zig's functions, langName MUST return the first word in lowercase and each later word with its first letter in capitals and the rest in lowercase."
    },
    {
      "id": "R-SHORT-CAPS",
      "section": "4.3",
      "level": "MUST",
      "quote": "For kotlin and dart, langName MUST write names as java does, except that a later word of exactly two capitals MUST stay in capitals."
    },
    {
      "id": "R-AS-WRITTEN",
      "section": "4.4",
      "level": "MUST",
      "quote": "For php and swift, langName MUST return the first word in lowercase and each later word with its first letter in capitals and the rest as written."
    },
    {
      "id": "R-CSHARP",
      "section": "4.5",
      "level": "MUST",
      "quote": "For csharp, langName MUST name a parameter as kotlin does, and a function the same way but with its first word's first letter in capitals."
    },
    {
      "id": "R-GO",
      "section": "4.6",
      "level": "MUST",
      "quote": "For go, langName MUST write a function's first word with its first letter in capitals, so that it is exported, and a parameter's first word in lowercase; any other word that is an acronym or one of golint's initialisms MUST be written in capitals."
    },
    {
      "id": "R-UNKNOWN",
      "section": "4.7",
      "level": "MUST",
      "quote": "For a language vector does not know, langName and langModule MUST return the name and the module unchanged."
    },
    {
      "id": "R-MODULE",
      "section": "5.1",
      "level": "MUST",
      "quote": "langModule MUST write a contract's module path (segments joined by /) the way its language names a module: a crate path for rust and cpp, a constant path for ruby, a source file for zig, a header for c, a namespace for csharp and php, a package and class for java and kotlin, a dotted module for python, a module name for swift and a package library for dart."
    },
    {
      "id": "R-QUALIFY",
      "section": "5.2",
      "level": "MUST",
      "quote": "langQualify MUST write a name as its language calls it from outside its module."
    }
  ],
  "exclusions": [],
  "functions": [
    {
      "name": "langName",
      "params": [
        {
          "name": "lang",
          "type": "string"
        },
        {
