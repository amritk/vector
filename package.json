{
  "name": "@amritk/vector",
  "version": "0.7.0",
  "description": "vector — a deterministic judge: prove a spec plan and program with Z3, and check implementations against spec and RFC contracts. Written in Nish; it never calls a model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amritk/vector.git"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "nish": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "engines": {
    "nish": ">=0.39.0"
  },
  "scripts": {
    "fetch-nish": "bash scripts/fetch-nish.sh",
    "fetch-z3": "bash scripts/fetch-z3.sh",
    "build": "mkdir -p dist && .nish/bin/nish src/main.ts --link dist/vector",
    "test": "node tests/run.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "tested-exports": "node scripts/tested-exports.mjs",
    "dogfood": "node scripts/dogfood.mjs",
    "doc-caps": "node scripts/doc-caps.mjs",
    "panics": "node scripts/panics.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "typedoc": "0.28.20",
    "typescript": "5.9.3"
  }
}
