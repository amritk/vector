{
  "name": "vector",
  "version": "0.1.0",
  "description": "vector — turn a casual prompt into a formally verified TypeScript program via LLM spec extraction, code+contract generation, and deterministic Z3 proof.",
  "type": "module",
  "main": "src/pipeline.ts",
  "bin": {
    "vector": "./src/cli.ts"
  },
  "scripts": {
    "vector": "bun src/cli.ts",
    "dev": "bun src/cli.ts",
    "build": "bun scripts/build-binary.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate:schemas": "mjst --schema-dir schemas --out-dir src/generated --strict",
    "format": "biome check . --write",
    "lint": "biome check ."
  },
  "dependencies": {
    "@amritk/helpers": "^0.12.0",
    "@anthropic-ai/sdk": "^0.98.0",
    "z3-solver": "4.16.0"
  },
  "devDependencies": {
    "@amritk/mjst": "^0.9.0",
    "@biomejs/biome": "^1.8.3",
    "bun-types": "^1.1.6",
    "typescript": "^5.5.3"
  }
}
